NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Server-only: configure these to enable AI-generated manager plans. Never prefix the API key with NEXT_PUBLIC_.
AI_GATEWAY_API_KEY=YOUR_VERCEL_AI_GATEWAY_API_KEY
AI_GATEWAY_MODEL=provider/model-id-from-ai-gateway

# Server-only local 9Router settings for wallpaper generation. Keep this file
# as an example; put real values in admin/.env.local, which is git-ignored.
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=
NINE_ROUTER_IMAGE_MODEL=ag/gemini-3.1-flash-image
NINE_ROUTER_TEXT_MODEL=

# The generation script saves locally by default. Supabase storage is optional
# and requires a service-role key only in this server-side environment.
WALLPAPER_STORAGE_DRIVER=local
SUPABASE_STORAGE_BUCKET=wallpaper-assets
SUPABASE_SERVICE_ROLE_KEY=

# Set cost from the router/provider's current pricing before batch generation.
NINE_ROUTER_COST_PER_IMAGE_USD=
WALLPAPER_JOB_MAX_COST_USD=
WALLPAPER_TARGET_COUNT=900
WALLPAPER_TARGET_WIDTH=2160
WALLPAPER_TARGET_HEIGHT=3840
